/-
Census: kernel-checked half-space certificates for two triples sharing `m = 1, 2` units.

For every pair of unit relabellings `s0, s1` of the two triples (lists of the images of `0, 1, 2`)
the vector `v = tp_look (tab m) s0 s1` satisfies, in exact integer arithmetic (`tp_hcheck`):
`S = ⟨v, Δz⟩ > 0` (the joint difference of the relabelled interior points, scaled by `2^24`),
`J vᵀ Δᵀ C_J Δ v ≤ S²` with `J = 13` (`m = 1`) and `J = 11` (`m = 2`), and `‖v‖₁ ≤ 3 S`.
-/
import IIT.Census.ThmP3Gauss

namespace IIT
namespace Census

open Finset

set_option maxRecDepth 100000

/-- The pattern permutation of a unit relabelling `s`, on naturals. -/
def tp_bpN (s : List ℕ) (t : ℕ) : ℕ := cd_nsumN 3 fun q => t / 2 ^ q % 2 * 2 ^ s.getD q 0

/-- The coordinate relabelling of a unit relabelling `s`, on naturals. -/
def tp_relN (s : List ℕ) (p : ℕ) : ℕ := tp_bpN s (p % 8) + 8 * s.getD (p / 8) 0

/-- The relabelled difference of the interior point (numerators over `2^24`). -/
def tp_zD (s : List ℕ) (p : ℕ) : ℤ :=
  cd_zi.getD (tp_relN s p) 0 - cd_zi.getD (tp_relN s (8 * (p / 8))) 0

/-- The joint relabelled difference of the interior point. -/
def tp_zc (s0 s1 : List ℕ) (P : ℕ) : ℤ := if P < 24 then tp_zD s0 P else tp_zD s1 (P - 24)

/-- `⟨v, Δz⟩` scaled by `2^24`. -/
def tp_Sv (s0 s1 : List ℕ) (v : List ℤ) : ℤ := cd_nsum 48 fun P => v.getD P 0 * tp_zc s0 s1 P

/-- The transpose of the joint difference map applied to `v`. -/
def tp_DTl (v : List ℤ) : List ℤ :=
  (List.range 48).map fun Q =>
    v.getD Q 0 - cd_nsum 48 fun P => if 8 * (P / 8) = Q then v.getD P 0 else 0

/-- `‖v‖₁`. -/
def tp_L1 (v : List ℤ) : ℤ := cd_nsum 48 fun P => |v.getD P 0|

/-- The check of a half-space certificate at rate `Jn / Jd` with slack constant `Kc`. -/
def tp_hcheck (m Jn Jd Kc : ℕ) (s0 s1 : List ℕ) (v : List ℤ) : Bool :=
  decide (0 < tp_Sv s0 s1 v) &&
  decide ((Jn : ℤ) * cd_QJz 3 m (tp_DTl v) * 2 ^ 48 ≤
    (Jd : ℤ) * (240 * 2 ^ (6 - m)) * tp_Sv s0 s1 v ^ 2) &&
  decide (tp_L1 v * 2 ^ 24 ≤ (Kc : ℤ) * tp_Sv s0 s1 v)

