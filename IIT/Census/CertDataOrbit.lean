theorem cd_W5_ok : cd_orbitCheck 5 cd_k5_list cd_W5 = true := by decide +kernel

/-- **Regions of Theorem E for `k = 5`.** For every partition `θ` of a `5`-set `S` with ordering
`e`, some relabelled ordering `e ∘ σ` pulls the profile of `θ` back to a certified representative
`C`, and the region of `C` is covered at rate `28923 / 10000`. -/
theorem cd_thmE_k5 {N : ℕ} {S : Finset (Fin N)} (e : Fin 5 ↪ Fin N)
    (hS : ∀ x, x ∈ S ↔ ∃ i, e i = x) (θ : SysPartition N S) :
    ∃ σ : Equiv.Perm (Fin 5), ∃ C ∈ cd_k5_list,
      (∀ i j : Fin 5, (e (σ j) ∈ profile θ (e (σ i)) ↔ cd_at C i j = true)) ∧
        cd_Covered 5 28923 10000 C := by
  obtain ⟨σ, C, hC, h⟩ := cd_classify_rep 5 e hS θ cd_k5_list cd_W5 cd_W5_ok
  exact ⟨σ, C, hC, h, cd_k5_covered C hC⟩

