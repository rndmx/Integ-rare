/-
Census, B1 LTBetaHi, module T3 (part 1): the RL_sym certificate of W8 §5 — data, checker, witnesses.

Two-block symmetric data `d = (G1, F1, G2, F2, V1, V2)` (W8 §2.1, after (R3)-(R4): `c = min 1 G1`). A merged table
`M u i` (pattern `u : Fin 8` as a bit mask relative to `tc`, column `i : Fin 3`) is admissible for target `Ts` if
* every entry lies in its interval (2.1): `u = 0: [G1, G1+V2]`, `u = {i}: [F1, F1+V2]`, `u = S: [G2, G2+V1]`,
  `u = S∖{i}: [F2, F2+V1]`, else `[0, V1+V2]`;
* (V) `v_{C*} ≥ c(5/3 - t)`, (G) `v_C/cc_C - v_{C*}/5 ≥ c t/20` for the other 21 profiles, (P) `PS(Ts) - PS(u) ≥ 1/20`;
where `8 v_C = Σ_{i,u} cd_fz 3 C 0 (u + 8i) · M(Ts ⊕ u, i)` (= `8 lp3V C ξ` with `ξ i u = M (Ts ⊕ u) i`, `lp3V_lin`).
Rays: the homogeneous version (right-hand sides `0`).
-/
import IIT.Census.CertLP3
import IIT.Census.B1LTHiTriple

namespace IIT
namespace Census

/-- Symmetric two-block data. -/
structure RLD where
  G1 : ℚ
  F1 : ℚ
  G2 : ℚ
  F2 : ℚ
  V1 : ℚ
  V2 : ℚ

def rlBit (i : ℕ) : ℕ := 2 ^ i

/-- Lower end of the interval of `(u, i)`. -/
def rlLo (d : RLD) (u i : ℕ) : ℚ :=
  if u = 0 then d.G1 else if u = rlBit i then d.F1 else if u = 7 then d.G2
  else if u = 7 - rlBit i then d.F2 else 0

/-- Width of the interval of `(u, i)`. -/
def rlWd (d : RLD) (u i : ℕ) : ℚ :=
  if u = 0 ∨ u = rlBit i then d.V2 else if u = 7 ∨ u = 7 - rlBit i then d.V1 else d.V1 + d.V2

/-- The table as a function of naturals. -/
def rlM (M : Fin 8 → Fin 3 → ℚ) (u i : ℕ) : ℚ := M ⟨u % 8, Nat.mod_lt _ (by decide)⟩ ⟨i % 3, Nat.mod_lt _ (by decide)⟩

def rlS8 (f : ℕ → ℚ) : ℚ := f 0 + f 1 + f 2 + f 3 + f 4 + f 5 + f 6 + f 7
def rlS3 (f : ℕ → ℚ) : ℚ := f 0 + f 1 + f 2

/-- `8 v_C` at target `Ts`. -/
def rlV8 (C : List (List Bool)) (Ts : ℕ) (M : Fin 8 → Fin 3 → ℚ) : ℚ :=
  rlS3 fun i => rlS8 fun u => (cd_fz 3 C 0 (u + 8 * i) : ℚ) * rlM M (Ts ^^^ u) i

/-- Pattern sums. -/
def rlPS (M : Fin 8 → Fin 3 → ℚ) (u : ℕ) : ℚ := rlS3 fun i => rlM M u i

def rlBox (d : RLD) (M : Fin 8 → Fin 3 → ℚ) : Bool :=
  (List.range 8).all fun u => (List.range 3).all fun i =>
    decide (rlLo d u i ≤ rlM M u i) && decide (rlM M u i ≤ rlLo d u i + rlWd d u i)

/-- **The admissibility checker** (vertices). -/
def rlAdmB (d : RLD) (t : ℚ) (Ts : ℕ) (M : Fin 8 → Fin 3 → ℚ) : Bool :=
  let c := min 1 d.G1
  rlBox d M &&
  decide (8 * c * (5 / 3 - t) ≤ rlV8 lp3CStar Ts M) &&
  lp3Profiles.all (fun C => C == lp3CStar ||
    decide (1 / 20 * c * t ≤ rlV8 C Ts M / (8 * (cd_cc 3 C : ℚ)) - rlV8 lp3CStar Ts M / 40)) &&
  (List.range 8).all fun u => u == Ts || decide (1 / 20 ≤ rlPS M Ts - rlPS M u)

/-- **The homogeneous checker** (rays). -/
def rlRayB (d : RLD) (Ts : ℕ) (M : Fin 8 → Fin 3 → ℚ) : Bool :=
  rlBox d M &&
  decide (0 ≤ rlV8 lp3CStar Ts M) &&
  lp3Profiles.all (fun C => C == lp3CStar ||
    decide (0 ≤ rlV8 C Ts M / (8 * (cd_cc 3 C : ℚ)) - rlV8 lp3CStar Ts M / 40)) &&
  (List.range 8).all fun u => u == Ts || decide (0 ≤ rlPS M Ts - rlPS M u)

